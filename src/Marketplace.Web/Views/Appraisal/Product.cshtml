@model IReadOnlyList<Marketplace.Application.Catalog.AppraisalOpinionDto>
@{
    ViewData["Title"] = "ความเห็นผู้ประเมิน (Admin)";
    var productId = (Guid)ViewData["ProductId"]!;
    var ok = TempData["AdminOk"] as string;
    var err = TempData["AdminError"] as string;

    // LEGAL #2: the latest disclaimer version on record (shown prominently). Opinions only — never a warranty.
    var latestDisclaimer = Model.Select(a => a.DisclaimerVersion).FirstOrDefault();
    var publishedCount = Model.Count(a => a.IsPublished);
}

@* ===== Page head ===== *@
<section class="container page-head">
  <div class="breadcrumb">Admin / ความเห็นผู้ประเมิน</div>
  <p class="eyebrow">◈ APPRAISAL · FR-07</p>
  <h1>ความเห็น<span class="gradient-text">ผู้ประเมิน</span></h1>
  <p class="muted stack-md">รหัสสินค้า: <span class="mono">@productId.ToString("N").Substring(0, 8).ToUpperInvariant()</span> · เผยแพร่อยู่ @publishedCount จาก @Model.Count รายการ</p>
</section>

@if (!string.IsNullOrEmpty(ok))
{
  <section class="container"><div class="alert alert-info" role="status"><span>✅</span><div>@ok</div></div></section>
}
@if (!string.IsNullOrEmpty(err))
{
  <section class="container"><div class="alert alert-danger" role="alert"><span>⚠️</span><div>@err</div></div></section>
}

@* ===== LEGAL #2 disclaimer (prominent) ===== *@
<section class="container" style="margin-bottom:var(--stack-md)">
  <div class="alert alert-warn">
    <span>⚖️</span>
    <div>
      <strong>นี่คือ "ความเห็น" ของผู้ประเมินเท่านั้น</strong> — เป็นความเห็นเบื้องต้น แพลตฟอร์มไม่ยืนยันและไม่ตัดสินความแท้ของสินค้า
      ห้ามใช้ถ้อยคำเช่น "รับประกัน" / "การันตี" / "ของแท้ 100%" / "guarantee" / "100% authentic" — ระบบจะปฏิเสธข้อความที่มีถ้อยคำเหล่านี้
      @if (!string.IsNullOrEmpty(latestDisclaimer))
      {
        <div class="stack-sm tiny mono">ฉบับข้อความกำกับ (Disclaimer): @latestDisclaimer</div>
      }
    </div>
  </div>
</section>

@* ===== Add new opinion ===== *@
<section class="container" style="margin-bottom:var(--stack-md)">
  <div class="glass" style="padding:24px; max-width:680px">
    <div class="section-head" style="margin-bottom:var(--stack-md)">
      <div><p class="eyebrow">เพิ่มความเห็น</p><h2 style="font-size:24px">บันทึกความเห็นใหม่</h2></div>
    </div>
    <form asp-action="Create" method="post">
      @Html.AntiForgeryToken()
      <input type="hidden" name="productId" value="@productId" />

      <div style="margin-bottom:var(--stack-md)">
        <label class="eyebrow">ชื่อผู้ประเมิน</label>
        <input name="appraiserName" class="input" maxlength="120" required placeholder="เช่น ทีมประเมิน Sasom Hub" />
      </div>

      <div style="margin-bottom:var(--stack-md)">
        <label class="eyebrow">ความเห็น</label>
        <textarea name="opinionText" class="textarea" rows="4" required placeholder="ความเห็นเบื้องต้นเกี่ยวกับสภาพ/ลักษณะของสินค้า (เป็นความเห็น ไม่ใช่การรับประกัน)"></textarea>
      </div>

      <label class="flex gap-sm" style="align-items:center; cursor:pointer; margin-bottom:var(--stack-md)">
        <input type="checkbox" name="publish" value="true" />
        <span class="muted tiny">เผยแพร่ทันที (ไม่เลือก = บันทึกเป็นฉบับร่าง)</span>
      </label>

      <button type="submit" class="btn btn-primary">บันทึกความเห็น</button>
    </form>
  </div>
</section>

@* ===== All opinions ===== *@
<section class="section container" style="padding-top:0">
  <div class="section-head">
    <div><p class="eyebrow">ทั้งหมด</p><h2>ความเห็นของสินค้านี้</h2></div>
  </div>

  @if (Model.Count == 0)
  {
    <div class="glass" style="padding:40px; text-align:center">
      <div style="font-size:40px; margin-bottom:12px">📝</div>
      <p class="muted">ยังไม่มีความเห็นสำหรับสินค้านี้</p>
    </div>
  }
  else
  {
    <div class="glass" style="padding:8px 18px 18px; overflow-x:auto">
      <table class="mono-table">
        <thead>
          <tr><th>ผู้ประเมิน</th><th>ความเห็น</th><th>Disclaimer</th><th>สถานะ</th><th>เมื่อ</th><th></th></tr>
        </thead>
        <tbody>
          @foreach (var a in Model)
          {
            <tr>
              <td>@a.AppraiserName</td>
              <td style="font-family:inherit; max-width:320px; white-space:normal">@a.OpinionText</td>
              <td class="tiny">@a.DisclaimerVersion</td>
              <td>
                @if (a.IsPublished)
                {
                  <span class="badge badge-verified">เผยแพร่</span>
                }
                else
                {
                  <span class="badge badge-trial">ฉบับร่าง</span>
                }
              </td>
              <td>@a.CreatedAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
              <td style="text-align:right">
                @if (a.IsPublished)
                {
                  <form asp-action="Unpublish" method="post" style="display:inline; margin:0">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="appraisalOpinionId" value="@a.AppraisalOpinionId" />
                    <input type="hidden" name="productId" value="@productId" />
                    <button type="submit" class="btn btn-ghost btn-sm">นำออก</button>
                  </form>
                }
                else
                {
                  <form asp-action="Publish" method="post" style="display:inline; margin:0">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="appraisalOpinionId" value="@a.AppraisalOpinionId" />
                    <input type="hidden" name="productId" value="@productId" />
                    <button type="submit" class="btn btn-primary btn-sm">เผยแพร่</button>
                  </form>
                }
              </td>
            </tr>
          }
        </tbody>
      </table>
    </div>
  }
</section>
