@model Marketplace.Web.Models.Disputes.RaiseDisputeViewModel
@{
    ViewData["Title"] = "เปิดข้อพิพาท";
    var result = TempData["DisputeResult"] as string;
    var message = TempData["DisputeMessage"] as string;
}

@* ===== Page head ===== *@
<section class="container page-head">
  <div class="breadcrumb">หน้าแรก / ข้อพิพาท / เปิดใหม่</div>
  <p class="eyebrow">◈ DISPUTES · FR-21</p>
  <h1>เปิด<span class="gradient-text">ข้อพิพาท</span></h1>
  <p class="muted stack-md" style="max-width:620px">บันทึกปัญหาที่เกิดกับธุรกรรม #@Model.TransactionId.ToString("N").Substring(0, 8).ToUpperInvariant() เพื่อให้ทีมงานช่วยไกล่เกลี่ย</p>
</section>

@* ===== FR-21 / LEGAL #1: mediation only ===== *@
<section class="container" style="margin-bottom:var(--stack-md)">
  <div class="alert alert-warn">
    <span>⚖️</span>
    <div><strong>การไกล่เกลี่ยเท่านั้น</strong> — แพลตฟอร์มทำหน้าที่เป็นคนกลางบันทึกและตรวจสอบข้อพิพาท ไม่มีการจ่ายหรือคืนเงินผ่านระบบ</div>
  </div>
</section>

@if (!string.IsNullOrEmpty(result) && !string.IsNullOrEmpty(message))
{
  <section class="container" style="margin-bottom:var(--stack-md)">
    <div class="alert @(result == "ok" ? "alert-info" : "alert-danger")" role="status">
      <span>@(result == "ok" ? "✅" : "⚠️")</span><div>@message</div>
    </div>
  </section>
}

@* ===== Form ===== *@
<section class="container" style="margin-bottom:var(--stack-lg)">
  <div class="glass" style="padding:24px; max-width:640px">
    <form asp-action="Raise" method="post">
      @Html.AntiForgeryToken()
      <input type="hidden" asp-for="TransactionId" />

      <div style="margin-bottom:var(--stack-md)">
        <label asp-for="ReasonCodeId" class="eyebrow">เหตุผล (รหัสมาตรฐาน)</label>
        <select asp-for="ReasonCodeId" class="select">
          @foreach (var rc in Model.ReasonCodes)
          {
            <option value="@rc.ReasonCodeId">@rc.DisplayName</option>
          }
        </select>
        <span asp-validation-for="ReasonCodeId" class="tiny" style="color:var(--error)"></span>
      </div>

      <div style="margin-bottom:var(--stack-md)">
        <label asp-for="Description" class="eyebrow">รายละเอียดเพิ่มเติม (ไม่บังคับ)</label>
        <textarea asp-for="Description" class="textarea" rows="5" placeholder="อธิบายสิ่งที่เกิดขึ้น เช่น สินค้าไม่ตรงปก จัดส่งไม่ครบ ฯลฯ"></textarea>
        <span asp-validation-for="Description" class="tiny" style="color:var(--error)"></span>
      </div>

      <div class="flex gap-sm wrap">
        <button type="submit" class="btn btn-buy">เปิดข้อพิพาท</button>
        <a asp-action="Index" class="btn btn-ghost">ยกเลิก</a>
      </div>
    </form>
  </div>
</section>
