@model Marketplace.Web.Models.Home.HomeViewModel
@{
    ViewData["Title"] = "หน้าแรก";

    // Helper: map a rarity slug to its Thai/English display label used in the .rarity badge.
    string RarityLabel(string r) => r?.ToLowerInvariant() switch
    {
        "legendary" => "Legendary",
        "epic" => "Epic",
        "rare" => "Rare",
        _ => "Common"
    };
}

@* ===== Hero ===== *@
<header class="hero">
  <div class="container hero-grid">
    <div>
      <p class="eyebrow">◈ DIGITAL RARITY VAULT</p>
      <h1>สะสม <span class="gradient-text">การ์ดหายาก</span><br>เหมือนถือสินทรัพย์</h1>
      <p>ตลาดการ์ดสะสมยุคใหม่สำหรับนักสะสม Gen Y/Z — ดูเรตติ้ง PSA ซีเรียลแท้ ประวัติราคาแบบเรียลไทม์ ประมูลสด และโอนตรงถึงผู้ขายอย่างปลอดภัย</p>
      <div class="hero-cta">
        <a asp-controller="Explore" asp-action="Index" class="btn btn-primary btn-lg">เริ่มเรียกดูการ์ด</a>
        <a asp-controller="Membership" asp-action="Index" class="btn btn-secondary btn-lg">ดูแพ็กเกจสมาชิก</a>
      </div>
      <div class="hero-stats">
        <div class="stat"><div class="num">24,800+</div><div class="lbl">การ์ดในวอลต์</div></div>
        <div class="stat"><div class="num">1,200+</div><div class="lbl">นักสะสม active</div></div>
        <div class="stat"><div class="num">฿38M</div><div class="lbl">มูลค่ารวม</div></div>
      </div>
    </div>
    <div class="hero-showcase">
      @* floating trading cards — decorative showcase, kept hardcoded from prototype *@
      <article class="tcard r-legendary c1">
        <div class="rarity legendary">Legendary</div>
        <div class="card-art"><div class="art-fill"></div><div class="refraction"></div><div class="art-glyph">🔥</div></div>
        <div class="card-body"><div class="card-title">Charizard 1st Ed.</div><div class="card-meta"><span class="price">฿128,000</span><span class="grade">PSA 10</span></div></div>
      </article>
      <article class="tcard r-epic c2">
        <div class="rarity epic">Epic</div>
        <div class="card-art"><div class="art-fill"></div><div class="refraction"></div><div class="art-glyph">⚡</div></div>
        <div class="card-body"><div class="card-title">Pikachu Illustrator</div><div class="card-meta"><span class="price">฿98,500</span><span class="grade">PSA 9</span></div></div>
      </article>
      <article class="tcard r-rare c3">
        <div class="rarity rare">Rare</div>
        <div class="card-art"><div class="art-fill"></div><div class="refraction"></div><div class="art-glyph">🌊</div></div>
        <div class="card-body"><div class="card-title">Lugia Neo Genesis</div><div class="card-meta"><span class="price">฿67,000</span><span class="grade">PSA 8</span></div></div>
      </article>
    </div>
  </div>
</header>

@* ===== Promo banner (FR-27 Free Trial 3 เดือน) ===== *@
<section class="container">
  <div class="banner banner-promo">
    <div>
      <span class="badge badge-trial">ฟรี 3 เดือน</span>
      <h3 class="stack-md">ทดลองใช้ฟรี 3 เดือน — เปิดเผยราคาชัดเจนตั้งแต่วันแรก</h3>
      <p class="muted">สมัครวันนี้ใช้สิทธิ์สมาชิกครบ ไม่มีการตัดเงินเงียบ เราแจ้งเตือนล่วงหน้า 14/3/1 วันก่อนหมดทดลอง</p>
    </div>
    <a asp-controller="Account" asp-action="Register" class="btn btn-buy btn-lg">เริ่มทดลองฟรี</a>
  </div>
</section>

@* ===== Card gallery (FR-08 เรียกดู) ===== *@
<section class="section container">
  <div class="section-head">
    <div><p class="eyebrow">HOT RIGHT NOW</p><h2>การ์ดมาแรง</h2></div>
    <a asp-controller="Explore" asp-action="Index" class="btn btn-ghost btn-sm">ดูทั้งหมด →</a>
  </div>
  <div class="card-grid">
    @if (Model.HotCards.Any())
    {
        foreach (var card in Model.HotCards)
        {
            <a asp-controller="Listings" asp-action="Detail" asp-route-id="@card.ProductId" class="tcard r-@card.Rarity.ToLowerInvariant()">
              <div class="rarity @card.Rarity.ToLowerInvariant()">@RarityLabel(card.Rarity)</div>
              <div class="card-art"><div class="art-fill"></div><div class="refraction"></div><div class="art-glyph">@card.Glyph</div></div>
              <div class="card-body">
                <div class="card-title">@card.Title</div>
                @if (!string.IsNullOrEmpty(card.SetLabel)) { <div class="card-set">@card.SetLabel</div> }
                <div class="card-meta">
                  <span class="price">@(card.Price.HasValue ? $"฿{card.Price.Value:N0}" : "—")</span>
                  @if (!string.IsNullOrEmpty(card.GradeLabel)) { <span class="grade">@card.GradeLabel</span> }
                </div>
                @if (!string.IsNullOrEmpty(card.SerialLabel)) { <div class="serial">SERIAL @card.SerialLabel</div> }
              </div>
            </a>
        }
    }
    else
    {
        @* TODO: frontend-dev — replace sample cards with Model.HotCards เมื่อ backend ต่อข้อมูล.
           ตัวอย่าง 8 ใบ hardcode ตาม prototype (index.html) เพื่อให้เห็นดีไซน์ในช่วงยังไม่มีข้อมูลจริง. *@
        var sampleCards = new[]
        {
            new { t = "Charizard 1st Ed.", set = "Base Set · 1999", r = "legendary", g = "PSA 10", p = "฿128,000", s = "#0042/0050", glyph = "🔥" },
            new { t = "Pikachu Illustrator", set = "Promo · 1998", r = "epic", g = "PSA 9", p = "฿98,500", s = "#0012/0039", glyph = "⚡" },
            new { t = "Black Lotus", set = "Alpha · MTG", r = "legendary", g = "BGS 9.5", p = "฿412,000", s = "#0003/1100", glyph = "🌸" },
            new { t = "Blue-Eyes White Dragon", set = "LOB · Yu-Gi-Oh!", r = "epic", g = "PSA 10", p = "฿54,200", s = "#0088/0500", glyph = "🐉" },
            new { t = "Umbreon VMAX Alt", set = "Evolving Skies", r = "rare", g = "PSA 9", p = "฿42,800", s = "#0210/0999", glyph = "🌙" },
            new { t = "Mewtwo GX", set = "Shining Legends", r = "rare", g = "PSA 8", p = "฿15,200", s = "#0455/2000", glyph = "🔮" },
            new { t = "Luffy Gear 5 Leader", set = "OP-05", r = "common", g = "PSA 9", p = "฿8,900", s = "#1204/5000", glyph = "🏴‍☠️" },
            new { t = "LeBron James Rookie", set = "Topps Chrome", r = "common", g = "BGS 8.5", p = "฿6,400", s = "#0780/3000", glyph = "🏀" }
        };
        foreach (var c in sampleCards)
        {
            <a asp-controller="Listings" asp-action="Detail" class="tcard r-@c.r">
              <div class="rarity @c.r">@RarityLabel(c.r)</div>
              <div class="card-art"><div class="art-fill"></div><div class="refraction"></div><div class="art-glyph">@c.glyph</div></div>
              <div class="card-body">
                <div class="card-title">@c.t</div>
                <div class="card-set">@c.set</div>
                <div class="card-meta"><span class="price">@c.p</span><span class="grade">@c.g</span></div>
                <div class="serial">SERIAL @c.s</div>
              </div>
            </a>
        }
    }
  </div>
</section>

@* ===== Categories (ชุดการ์ด/แบรนด์) ===== *@
<section class="section container">
  <div class="section-head"><div><p class="eyebrow">BROWSE BY SET</p><h2>ชุดการ์ด &amp; แบรนด์</h2></div></div>
  <div class="cat-grid">
    @if (Model.Categories.Any())
    {
        foreach (var cat in Model.Categories)
        {
            <a class="cat glass" asp-controller="Explore" asp-action="Index" asp-route-set="@cat.Slug">
              <div class="cat-name">@cat.Name</div>
              <div class="cat-count mono">@cat.Count.ToString("N0") การ์ด</div>
            </a>
        }
    }
    else
    {
        @* TODO: frontend-dev — replace sample category tiles with Model.Categories เมื่อ backend ต่อข้อมูล. *@
        <a class="cat glass" asp-controller="Explore" asp-action="Index"><div class="cat-name">⚡ Pokémon TCG</div><div class="cat-count mono">8,420 การ์ด</div></a>
        <a class="cat glass" asp-controller="Explore" asp-action="Index"><div class="cat-name">🃏 Magic: The Gathering</div><div class="cat-count mono">5,110 การ์ด</div></a>
        <a class="cat glass" asp-controller="Explore" asp-action="Index"><div class="cat-name">🐉 Yu-Gi-Oh!</div><div class="cat-count mono">3,890 การ์ด</div></a>
        <a class="cat glass" asp-controller="Explore" asp-action="Index"><div class="cat-name">🏀 NBA Hoops</div><div class="cat-count mono">2,300 การ์ด</div></a>
        <a class="cat glass" asp-controller="Explore" asp-action="Index"><div class="cat-name">⚽ Football Prizm</div><div class="cat-count mono">1,940 การ์ด</div></a>
        <a class="cat glass" asp-controller="Explore" asp-action="Index"><div class="cat-name">🎴 One Piece TCG</div><div class="cat-count mono">3,140 การ์ด</div></a>
    }
  </div>
</section>
