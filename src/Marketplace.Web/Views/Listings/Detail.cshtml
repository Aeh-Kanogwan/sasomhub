@model Marketplace.Web.Models.Catalog.ListingDetailViewModel
@{
    ViewData["Title"] = string.IsNullOrEmpty(Model.Card.Title) ? "รายละเอียดการ์ด" : Model.Card.Title;

    var rarity = string.IsNullOrEmpty(Model.Card.Rarity) ? "legendary" : Model.Card.Rarity.ToLowerInvariant();
    string RarityLabel(string r) => r switch
    {
        "legendary" => "Legendary",
        "epic" => "Epic",
        "rare" => "Rare",
        _ => "Common"
    };
    var hasCard = !string.IsNullOrEmpty(Model.Card.Title);
}

<div class="container page-head">
  <div class="breadcrumb">HOME / EXPLORE / POKÉMON / @(hasCard ? Model.Card.Title.ToUpperInvariant() : "CHARIZARD 1ST ED.")</div>
</div>

<section class="container section" style="padding-top:8px">
  <div class="detail-grid">
    @* Big card art + refraction *@
    <div>
      <div class="detail-art tcard r-@rarity" style="transform:none">
        <div class="rarity @rarity">@RarityLabel(rarity)</div>
        <div class="card-art" style="aspect-ratio:3/4">
          <div class="art-fill"></div><div class="refraction"></div>
          @* FR-06: real ProductImages when present; otherwise the prototype glyph fallback. *@
          @if (Model.ImageUrls.Any())
          {
              <img class="art-img" src="@Model.ImageUrls.First()" alt="@Model.Card.Title" style="width:100%;height:100%;object-fit:cover" />
          }
          else
          {
              <div class="art-glyph" style="font-size:120px">@(string.IsNullOrEmpty(Model.Card.Glyph) ? "🔥" : Model.Card.Glyph)</div>
          }
        </div>
      </div>
      @* Thumbnails — bound to ProductImages; decorative placeholders only when no images uploaded. *@
      <div class="flex gap-sm stack-md">
        @if (Model.ImageUrls.Any())
        {
            foreach (var url in Model.ImageUrls.Take(4))
            {
                <div class="glass" style="padding:10px;flex:1;text-align:center"><div class="card-art" style="aspect-ratio:1;border-radius:8px"><img src="@url" alt="@Model.Card.Title" style="width:100%;height:100%;object-fit:cover;border-radius:8px" /></div></div>
            }
        }
        else
        {
            <div class="glass" style="padding:10px;flex:1;text-align:center"><div class="card-art" style="aspect-ratio:1;border-radius:8px"><div class="art-fill"></div><div class="art-glyph" style="font-size:28px">@(string.IsNullOrEmpty(Model.Card.Glyph) ? "🔥" : Model.Card.Glyph)</div></div></div>
            <div class="glass" style="padding:10px;flex:1;text-align:center"><div class="card-art" style="aspect-ratio:1;border-radius:8px"><div class="art-fill"></div><div class="art-glyph" style="font-size:28px">↩️</div></div></div>
            <div class="glass" style="padding:10px;flex:1;text-align:center"><div class="card-art" style="aspect-ratio:1;border-radius:8px"><div class="art-fill"></div><div class="art-glyph" style="font-size:28px">🔍</div></div></div>
        }
      </div>
    </div>

    @* Details *@
    <div>
      <div class="flex gap-sm wrap">
        <span class="rarity @rarity" style="position:static">@RarityLabel(rarity)</span>
        @if (!string.IsNullOrEmpty(Model.Card.GradeLabel)) { <span class="grade">@Model.Card.GradeLabel</span> }
      </div>
      <h1 style="font-size:36px;margin-top:14px">@(hasCard ? Model.Card.Title : "Charizard 1st Edition")</h1>
      <p class="muted">@(string.IsNullOrEmpty(Model.Card.SetLabel) ? "Pokémon Base Set · Holofoil · 1999 · ภาษาอังกฤษ" : Model.Card.SetLabel)</p>

      <div class="glass" style="padding:18px;margin-top:20px">
        <div class="spec"><span class="k">ราคาตั้งขาย</span><span class="price" style="font-size:28px">@(Model.Card.Price.HasValue ? $"฿{Model.Card.Price.Value:N0}" : "฿128,000")</span></div>
        @if (Model.Specs.Any())
        {
            foreach (var spec in Model.Specs)
            {
                <div class="spec"><span class="k">@spec.Key</span><span class="v">@spec.Value</span></div>
            }
        }
        else
        {
            @* TODO: frontend-dev — replace sample specs with Model.Specs เมื่อ backend ต่อข้อมูล. *@
            <div class="spec"><span class="k">เกรด</span><span class="v">PSA 10 (Cert #82910442)</span></div>
            <div class="spec"><span class="k">ซีเรียล</span><span class="v">0042 / 0050</span></div>
            <div class="spec"><span class="k">สภาพ</span><span class="v">GEM MINT · Centered</span></div>
            <div class="spec"><span class="k">ปีที่ผลิต</span><span class="v">1999</span></div>
        }
      </div>

      <div class="flex gap-md stack-md">
        <a asp-controller="Transfer" asp-action="Index" asp-route-id="@Model.Card.ProductId" class="btn btn-buy btn-lg btn-block">🛒 ซื้อทันที (สมาชิก active)</a>
        @if (Model.IsAuction)
        {
            <a asp-controller="Auctions" asp-action="Index" asp-route-id="@Model.AuctionId" class="btn btn-secondary btn-lg btn-block">⚡ เสนอราคา</a>
        }
        else
        {
            <a asp-controller="Auctions" asp-action="Index" class="btn btn-secondary btn-lg btn-block">⚡ เสนอราคา</a>
        }
      </div>
      @* FR-10: buying/bidding reserved for active members — kept verbatim. *@
      <div class="alert alert-info stack-md">ℹ️ การซื้อ/เสนอราคาสงวนสำหรับสมาชิกที่ membership ยัง active เท่านั้น (FR-10) — <a asp-controller="Membership" asp-action="Index" style="color:var(--primary-fixed)">ดูแพ็กเกจ</a></div>

      @* Seller (FR-16 Trust Score) *@
      <div class="glass stack-md" style="padding:18px">
        <div class="seller">
          @{
              var sellerName = string.IsNullOrEmpty(Model.Seller.DisplayName) ? "KanoVault" : Model.Seller.DisplayName;
              var initials = sellerName.Length >= 2 ? sellerName.Substring(0, 2).ToUpperInvariant() : sellerName.ToUpperInvariant();
              var trust = Model.Seller.TrustScore > 0 ? Model.Seller.TrustScore : 96;
              var lvl = Model.Seller.CollectorLevel ?? 28;
              var deals = Model.Seller.CompletedDeals > 0 ? Model.Seller.CompletedDeals : 340;
          }
          <div class="avatar">@initials</div>
          <div style="flex:1">
            <div class="flex center gap-sm">
              <strong>@sellerName</strong>
              @if (Model.Seller.IsVerified) { <span class="badge badge-verified">✓ Verified</span> }
            </div>
            <div class="tiny muted mono">Trust Score <span class="trust">@trust</span> · Collector Lv.@lvl · ดีลสำเร็จ @deals รายการ</div>
          </div>
          <a asp-controller="Account" asp-action="Profile" asp-route-id="@Model.Seller.SellerId" class="btn btn-ghost btn-sm">ดูโปรไฟล์</a>
        </div>
      </div>
    </div>
  </div>

  @* Price history (mono chart + table) FR-16 *@
  <div class="stack-lg">
    <div class="section-head"><div><p class="eyebrow">MARKET DATA</p><h2 style="font-size:26px">ประวัติราคา</h2></div></div>
    <div class="glass" style="padding:24px">
      @if (Model.PriceHistory.Any())
      {
          @* Chart bars scaled to max price in the series. *@
          var maxPrice = Model.PriceHistory.Max(h => h.Price);
          <div class="chart">
            @foreach (var row in Model.PriceHistory.Reverse())
            {
                var h = maxPrice > 0 ? (int)Math.Round((double)(row.Price / maxPrice) * 100) : 0;
                <div class="bar" style="height:@(h)%"></div>
            }
          </div>
          <table class="mono-table stack-md">
            <thead><tr><th>วันที่</th><th>เกรด</th><th>ราคาขาย</th><th>เปลี่ยนแปลง</th></tr></thead>
            <tbody>
              @foreach (var row in Model.PriceHistory)
              {
                  <tr>
                    <td>@row.Date.ToString("yyyy-MM-dd")</td>
                    <td>@row.Grade</td>
                    <td>฿@row.Price.ToString("N0")</td>
                    <td class="@(row.ChangePercent >= 0 ? "up" : "down")">@(row.ChangePercent >= 0 ? "▲ +" : "▼ ")@row.ChangePercent.ToString("0.0")%</td>
                  </tr>
              }
            </tbody>
          </table>
      }
      else
      {
          @* TODO: frontend-dev — replace sample price history with Model.PriceHistory เมื่อ backend ต่อข้อมูล. *@
          <div class="chart">
            <div class="bar" style="height:40%"></div><div class="bar" style="height:52%"></div><div class="bar" style="height:48%"></div>
            <div class="bar" style="height:65%"></div><div class="bar" style="height:60%"></div><div class="bar" style="height:78%"></div>
            <div class="bar" style="height:72%"></div><div class="bar" style="height:88%"></div><div class="bar" style="height:95%"></div>
            <div class="bar" style="height:84%"></div><div class="bar" style="height:100%"></div>
          </div>
          <table class="mono-table stack-md">
            <thead><tr><th>วันที่</th><th>เกรด</th><th>ราคาขาย</th><th>เปลี่ยนแปลง</th></tr></thead>
            <tbody>
              <tr><td>2026-06-10</td><td>PSA 10</td><td>฿128,000</td><td class="up">▲ +4.2%</td></tr>
              <tr><td>2026-05-22</td><td>PSA 10</td><td>฿122,800</td><td class="up">▲ +1.8%</td></tr>
              <tr><td>2026-04-30</td><td>PSA 9</td><td>฿98,500</td><td class="down">▼ -2.1%</td></tr>
              <tr><td>2026-03-15</td><td>PSA 10</td><td>฿120,600</td><td class="up">▲ +6.0%</td></tr>
              <tr><td>2026-02-08</td><td>PSA 10</td><td>฿113,800</td><td class="up">▲ +3.3%</td></tr>
            </tbody>
          </table>
      }
    </div>
  </div>

  @* Independent appraiser opinion (FR-07 / FR-34) — disclaimer ต้องคงไว้ครบ, ห้ามคำรับประกัน/การันตี/ของแท้ 100% *@
  <div class="stack-lg">
    <div class="section-head"><div><p class="eyebrow">INDEPENDENT OPINION</p><h2 style="font-size:26px">ความเห็นประกอบจากผู้ประเมินอิสระ</h2></div></div>
    @if (Model.Appraisals.Any())
    {
        foreach (var ap in Model.Appraisals)
        {
            var apInitials = ap.AppraiserName.Length >= 2 ? ap.AppraiserName.Substring(0, 2).ToUpperInvariant() : "AP";
            <div class="glass" style="padding:24px">
              <div class="seller" style="margin-bottom:14px">
                <div class="avatar" style="background:linear-gradient(135deg,var(--secondary-container),var(--primary-container))">@apInitials</div>
                <div>
                  <strong>@ap.AppraiserName — ผู้ประเมินอิสระ (บุคคลภายนอก)</strong>
                  <div class="tiny muted mono">บันทึกเมื่อ @ap.CreatedAtUtc.ToString("yyyy-MM-dd") · disclaimer @ap.DisclaimerVersion</div>
                </div>
              </div>
              <p style="line-height:1.7">@ap.OpinionText</p>
              <div class="disclaimer stack-md">
                ⚠️ นี่คือ <strong>ความเห็นประกอบจากผู้ประเมินอิสระ ซึ่งเป็นบุคคลภายนอก ไม่ใช่การรับรองหรือคำยืนยันใด ๆ ของแพลตฟอร์ม</strong> Sasom Hub ไม่รับรองและไม่รับผิดชอบต่อความถูกต้องของความเห็นดังกล่าว ผู้ซื้อควรใช้วิจารณญาณและตรวจสอบสินค้าด้วยตนเองก่อนตัดสินใจ
              </div>
            </div>
        }
    }
    else
    {
        @* TODO: frontend-dev — replace sample appraisal with Model.Appraisals เมื่อ backend ต่อข้อมูล.
           ถ้อยคำ disclaimer (FR-07/FR-34) ต้องคงไว้ทุกตัว และห้ามมีคำ "รับประกัน/การันตี/ของแท้ 100%". *@
        <div class="glass" style="padding:24px">
          <div class="seller" style="margin-bottom:14px">
            <div class="avatar" style="background:linear-gradient(135deg,var(--secondary-container),var(--primary-container))">AP</div>
            <div>
              <strong>คุณ อภิชาติ ป. — ผู้ประเมินอิสระ (บุคคลภายนอก)</strong>
              <div class="tiny muted mono">บันทึกเมื่อ 2026-06-09 · disclaimer v2.1</div>
            </div>
          </div>
          <p style="line-height:1.7">"การ์ดอยู่ในสภาพดีมาก มุมคม โฮโลกราฟิกชัด การจัดวาง (centering) อยู่ในเกณฑ์สูง สอดคล้องกับเรตติ้ง PSA 10 ที่ได้รับ ทั้งนี้เป็นการสังเกตด้วยสายตาและประสบการณ์ส่วนบุคคล ผู้สนใจควรตรวจสอบเพิ่มเติมด้วยตนเอง"</p>
          <div class="disclaimer stack-md">
            ⚠️ นี่คือ <strong>ความเห็นประกอบจากผู้ประเมินอิสระ ซึ่งเป็นบุคคลภายนอก ไม่ใช่การรับรองหรือคำยืนยันใด ๆ ของแพลตฟอร์ม</strong> Sasom Hub ไม่รับรองและไม่รับผิดชอบต่อความถูกต้องของความเห็นดังกล่าว ผู้ซื้อควรใช้วิจารณญาณและตรวจสอบสินค้าด้วยตนเองก่อนตัดสินใจ
          </div>
        </div>
    }
  </div>

  @* warn-on-deal (FR-17) — neutral wording, shown only to viewer; never expose blacklist details publicly *@
  @if (!string.IsNullOrEmpty(Model.WarnOnDealMessage))
  {
      <div class="alert alert-warn stack-lg">⚠️ <div>@Model.WarnOnDealMessage</div></div>
  }
  else
  {
      @* TODO: frontend-dev — แสดงเฉพาะเมื่อ Model.WarnOnDealMessage ไม่ว่าง. ข้อความตัวอย่างจาก prototype คงสถานะปกติ. *@
      <div class="alert alert-warn stack-lg">⚠️ <div><strong>การแจ้งเตือนคู่ธุรกรรม (ตัวอย่าง):</strong> หากคู่ค้าของคุณเคยถูกระงับเนื่องจากละเมิดข้อกำหนด ระบบจะแสดงคำเตือนด้วยถ้อยคำกลางเฉพาะแก่คุณก่อนตกลงดีล (ไม่เปิดเผยต่อสาธารณะ) — กรณีนี้ผู้ขายมีสถานะปกติ</div></div>
  }
</section>
